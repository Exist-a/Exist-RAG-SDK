{
  "name": "@rag-sdk/adapters",
  "version": "1.0.1",
  "description": "Adapters for LLM, embedding, vector store and other external services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./langchain": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./chroma": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "echo 'Run demo with: npx tsx demo/langchain-adapter.ts or npx tsx demo/chroma-adapter.ts'"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.32",
    "@langchain/core": "^1.1.44",
    "@langchain/textsplitters": "^1.0.1",
    "@rag-sdk/core": "workspace:^",
    "@rag-sdk/indexing": "workspace:^",
    "@rag-sdk/utils": "workspace:^",
    "chromadb": "^3.4.3",
    "langchain": "^1.4.0"
  },
